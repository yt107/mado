# 開発用の環境変数の見本。.env.local にコピーして、値を入れる（.env.local はコミットしない）
# 本番の値は Secret Manager にあり、.github/workflows/ci.yml の deploy で Cloud Run に渡している

# Supabase（開発用プロジェクト）の Session pooler の接続文字列（ポート 5432）
DATABASE_URL=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32 で作る
BETTER_AUTH_SECRET=

# Google ログイン（開発用の OAuth クライアント。リダイレクト URI は http://localhost:3000/api/auth/callback/google）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# iCal の URL を暗号化する鍵。32バイトを Base64 にしたもの（openssl rand -base64 32 で作る）
ENCRYPTION_KEY=

# 掃除用 API（POST /api/maintenance/cleanup）の合言葉。空なら、その API は 404 を返す
CRON_SECRET=
